{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/backend/node_modules/typescript/bin/tsc",
        "-p",
        "${workspaceFolder}/backend/tsconfig.json"
      ],
      "problemMatcher": "$tsc"
    },
    {
      "label": "backend: ready",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/backend/scripts/wait-for-api.mjs"],
      "problemMatcher": []
    },
    {
      "label": "frontend: ready",
      "dependsOn": ["npm: start", "backend: ready"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "npm: start",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/node_modules/@angular/cli/bin/ng.js", "serve", "--port", "4200"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Building|Changes detected|File change detected"
          },
          "endsPattern": {
            "regexp": "Local:.*localhost:4200|Application bundle generation complete"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(.*?)"
          },
          "endsPattern": {
            "regexp": "bundle generation complete"
          }
        }
      }
    }
  ]
}
