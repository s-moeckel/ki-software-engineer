{
  "name": "angular-workshop-modern",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format.write": "prettier --write \"src/**/*.{ts,html,md,css,json}\"",
    "backend": "npm --prefix backend run dev",
    "build.angular-mcp": "tsc --project tools/angular-mcp/tsconfig.json --watch",
    "build.book-mcp": "tsc --project tools/book-mcp/tsconfig.json",
    "start.book-mcp": "node dist/book-mcp/index.js",
    "test.book-mcp": "npm run build.book-mcp && node --test tools/book-mcp/test/*.test.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/animations": "21.2.26",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-server": "21.2.26",
    "@angular/router": "21.2.26",
    "@angular/ssr": "21.2.30",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ngrx/signals": "21.1.1",
    "@tanstack/angular-query-experimental": "^5.85.5",
    "express": "5.1.0",
    "rxjs": "7.8.0",
    "three": "^0.187.0",
    "tslib": "2.3.0",
    "zod": "^4.6.7",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.30",
    "@angular/cli": "21.2.30",
    "@angular/compiler-cli": "21.2.26",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.19.43",
    "@types/three": "^0.187.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2"
  }
}
